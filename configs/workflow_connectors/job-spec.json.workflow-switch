{
  "id": "job-workflow-switch:v1.0.0",
  "job-version": "v1.0.0",
  "label": "Workflow connector: switch",
  "description": "N-way routing: evaluate cases (or a $.-ref label against choices) and route to the winning arm.",
  "container": "hysds/workflow-connectors:v1.0.0",
  "command": "/home/ops/workflow_connectors/run_switch.sh",
  "recommended-queues": [
    "workflow-connector-switch"
  ],
  "imported_worker_files": {
    "$HOME/.netrc": [
      "/home/ops/.netrc"
    ],
    "$HOME/.aws": [
      "/home/ops/.aws",
      "ro"
    ]
  },
  "params": [
    {
      "name": "run_id",
      "destination": "context"
    },
    {
      "name": "step_id",
      "destination": "context"
    },
    {
      "name": "spec_id",
      "destination": "context"
    },
    {
      "name": "workflow_event",
      "destination": "context"
    }
  ],
  "disable_pre_builtins": true,
  "disable_post_builtins": true,
  "pre": [],
  "post": [],
  "disk_usage": "1MB",
  "soft_time_limit": 300,
  "time_limit": 360,
  "enable_dedup": false
}
