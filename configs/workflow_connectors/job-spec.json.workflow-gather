{
  "id": "job-workflow-gather:v1.0.0",
  "job-version": "v1.0.0",
  "label": "Workflow connector: gather",
  "description": "Collect the scattered children's outputs and submit the downstream step. Runs once, on barrier release.",
  "container": "hysds/workflow-connectors:v1.0.0",
  "command": "/home/ops/workflow_connectors/run_gather.sh",
  "recommended-queues": [
    "workflow-connector-gather"
  ],
  "imported_worker_files": {},
  "runtime_options": {
    "network": "host",
    "env-file": "$HOME/.workflow-connectors.env"
  },
  "params": [
    {
      "name": "run_id",
      "destination": "context"
    },
    {
      "name": "step_id",
      "destination": "context"
    },
    {
      "name": "spec_id",
      "destination": "context"
    },
    {
      "name": "workflow_event",
      "destination": "context"
    }
  ],
  "disable_pre_builtins": true,
  "disable_post_builtins": true,
  "pre": [],
  "post": [],
  "disk_usage": "1MB",
  "soft_time_limit": 900,
  "time_limit": 1020,
  "enable_dedup": false
}
