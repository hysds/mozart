{
  "id": "job-workflow-gate:v1.0.0",
  "job-version": "v1.0.0",
  "label": "Workflow connector: gate",
  "description": "Evaluate the binary {left, op, right} condition and route to on_true or on_false.",
  "container": "hysds/workflow-connectors:v1.0.0",
  "command": "/home/ops/workflow_connectors/run_gate.sh",
  "recommended-queues": [
    "workflow-connector-gate"
  ],
  "imported_worker_files": {
    "$HOME/.netrc": [
      "/home/ops/.netrc"
    ],
    "$HOME/.aws": [
      "/home/ops/.aws",
      "ro"
    ]
  },
  "params": [
    {
      "name": "run_id",
      "destination": "context"
    },
    {
      "name": "step_id",
      "destination": "context"
    },
    {
      "name": "spec_id",
      "destination": "context"
    },
    {
      "name": "workflow_event",
      "destination": "context"
    }
  ],
  "disable_pre_builtins": true,
  "disable_post_builtins": true,
  "pre": [],
  "post": [],
  "disk_usage": "1MB",
  "soft_time_limit": 300,
  "time_limit": 360,
  "enable_dedup": false
}
