{
  "id": "job-workflow-decide:v1",
  "job-version": "v1",
  "label": "Workflow decision job",
  "description": "Evaluate an ordered list of cases {name, when} against a value; first match wins. Writes one boolean output per case plus otherwise (exactly one true).",
  "container": "hysds/workflow-connectors:v2.0.0",
  "command": "/home/ops/workflow_connectors/run_decide.sh",
  "recommended-queues": [
    "workflow-connector-decide"
  ],
  "imported_worker_files": {},
  "runtime_options": {
    "network": "host"
  },
  "params": [
    {"name": "value", "destination": "context"},
    {"name": "cases", "destination": "context"},
    {"name": "otherwise", "destination": "context"}
  ],
  "disable_pre_builtins": true,
  "disable_post_builtins": true,
  "pre": [],
  "post": [],
  "disk_usage": "1MB",
  "soft_time_limit": 300,
  "time_limit": 360,
  "enable_dedup": false
}
